# ---- Required -------------------------------------------------------------
# Neon PostgreSQL connection string (Neon dashboard -> Connection details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Used only by `npm run migrate` to create the first Super Admin
SUPER_ADMIN_NAME=Owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# ---- WhatsApp (needed before real numbers can receive messages) --------------
# From your Meta app: App settings -> Basic -> App secret. Used to verify webhook signatures.
META_APP_SECRET=
# Any string you choose. Enter the same value as "Verify token" when setting the webhook in Meta.
META_VERIFY_TOKEN=
# Optional: Graph API version and the country code added to 10-digit numbers
META_GRAPH_VERSION=v21.0
DEFAULT_COUNTRY_CODE=91

# ---- Optional -------------------------------------------------------------
# Separate key for encrypting channel access tokens (falls back to a key derived from JWT_SECRET)
ENCRYPTION_KEY=
# Turns on the AI Bot automation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Shown on the Privacy / Terms pages (build-time, so it must start with VITE_)
VITE_CONTACT_EMAIL=
